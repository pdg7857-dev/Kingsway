# ── Email notifications (Resend) ──────────────────────────────
# If RESEND_API_KEY is absent, lead emails are logged to the server
# console instead, so the app runs without secrets.
RESEND_API_KEY=
NOTIFY_EMAIL=phil@example.com

# ── Database ──────────────────────────────────────────────────
# Local: SQLite. Production: swap schema.prisma provider to postgresql
# and point DATABASE_URL at your Postgres instance.
DATABASE_URL="file:./dev.db"

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cards.phildave.com
